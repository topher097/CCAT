#!/bin/bash
export UV_PROJECT_ENVIRONMENT=$(pwd)/.venv
export DEFAULT_CONFIG=$(pwd)/config/ccat_2026.json

eval "$(devbox generate direnv --print-envrc)"

# --- docker compose (docker-compose.yml interpolates these) ----------------
# Public deployment settings.  Secrets do NOT belong here: put them in
# .envrc.private (gitignored), which is sourced below and therefore wins.
#
#   CCAT_SESSION_SECRET       cookie-session signing secret
#   ZITE_API_KEY              Zite table API key
#   ZEROBOUNCE_API_KEY        ZeroBounce email check key
#   OPENCODE_SERVER_PASSWORD  basic auth for the opencode server
#   OIDC_CLIENT_SECRET        OIDC client secret (adapter not implemented yet)
export CCAT_DOMAIN=localhost
export CCAT_ACME_EMAIL=
export CCAT_IMAGE_TAG=local
export OPENCODE_BASE_URL=http://opencode:4097
export OPENCODE_AUTH_FILE=$HOME/.local/share/opencode/auth.json
export OIDC_ISSUER=
export OIDC_CLIENT_ID=

source_env .envrc.private

# devbox PYTHONPATH points at nix python3.13 site-packages; venv is 3.12.
# Keeps 3.13 C extensions from shadowing venv packages.
export PYTHONPATH=""

# Project scripts (ccat, gdrive, zite) are entry points installed in the
# uv venv; put them on PATH ahead of the devbox python.
PATH_add .venv/bin

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details
