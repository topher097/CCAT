#!/bin/bash
export UV_PROJECT_ENVIRONMENT=$(pwd)/.venv
export CLOUDPATHLIB_LOCAL_CACHE_DIR=$(dirname "$(pwd)")/IO
#sudo mkdir -p $CLOUDPATHLIB_LOCAL_CACHE_DIR
export S3_PYTEST_BUCKET_URI="s3://pgi-mainlibrary"

eval "$(devbox generate direnv --print-envrc)"

source_env .envrc.private

# devbox PYTHONPATH points at nix python3.13 site-packages; venv is 3.12.
# Keeps 3.13 C extensions from shadowing venv packages.
export PYTHONPATH=""

# Project scripts (ccat, gdrive, zite) are entry points installed in the
# uv venv; put them on PATH ahead of the devbox python.
PATH_add .venv/bin

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details
