# CCAT deployment environment (copy to .env, fill in, NEVER commit .env).
# Compose reads .env automatically; every value here is a placeholder.

# --- Required for the prod profile ---------------------------------------
# Public hostname served by Caddy. localhost = internal CA + dev-style host.
CCAT_DOMAIN=localhost
# Let's Encrypt account email. Leave EMPTY for the internal CA (dev/single
# host rehearsal); set it for real TLS certificates.
CCAT_ACME_EMAIL=

# Cookie-session signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CCAT_SESSION_SECRET=replace-me-with-a-random-48-byte-urlsafe-token

# Image tag built/deployed by compose (rollback = pin the previous tag).
CCAT_IMAGE_TAG=local

# --- External providers (only needed by the jobs that call them) ----------
ZITE_API_KEY=replace-me-zite-api-key
ZEROBOUNCE_API_KEY=replace-me-zerobounce-api-key

# Optional: attach to an external opencode server instead of starting one.
# OPENCODE_BASE_URL=http://opencode:4096

# --- Reserved for the OIDC adapter (not implemented yet, decision D2) -----
# OIDC_ISSUER=https://login.example.com/
# OIDC_CLIENT_ID=replace-me
# OIDC_CLIENT_SECRET=replace-me
