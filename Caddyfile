# Production ingress (plan §13): one hostname, same-origin SPA + API.
#
#   CCAT_DOMAIN      public hostname (default: localhost)
#   CCAT_ACME_EMAIL  Let's Encrypt account email; when unset Caddy uses its
#                    internal CA instead (dev/single-host rehearsal only)
#
# The compiled SPA is mounted read-only at /srv/frontend by compose.
{$CCAT_DOMAIN:localhost} {
	encode zstd gzip
	tls {$CCAT_ACME_EMAIL:internal}

	handle /api/* {
		reverse_proxy api:8650
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# SAMEORIGIN, not DENY: the dispatch page and the job pages open in
		# an in-page pop-up iframe, and the app only ever frames its own
		# origin.
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		-Server
	}
}
